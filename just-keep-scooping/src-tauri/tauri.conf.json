{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Just Keep Scooping",
  "version": "1.0.0",
  "identifier": "com.justkeepscooping.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Just Keep Scooping",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": ["steam_appid.txt"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "shortDescription": "A raccoon incremental about garbage and tiny ties.",
    "longDescription": "Scoop dumpsters, sell junk to Uncle Gary, and spend every coin on The Scheme — a branching upgrade tree that unlocks worse ideas the more you invest.",
    "category": "Game",
    "copyright": "MIT"
  }
}
